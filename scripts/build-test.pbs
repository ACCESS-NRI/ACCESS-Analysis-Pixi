#!/usr/bin/env bash
# qsub supplies project, queue, storage, resources and GADI_RUN_DIR.
set -Eeuo pipefail
umask 022
: "${GADI_RUN_DIR:?}"
: "${PBS_JOBID:?}"
repo="$GADI_RUN_DIR/repo"
work="$GADI_RUN_DIR/work"
artifact="$GADI_RUN_DIR/artifact"
status="$GADI_RUN_DIR/status"
finish() { rc=$?; printf '%s\n' "$rc" > "$status"; exit "$rc"; }
trap finish EXIT
trap 'printf "failed line=%s command=%s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR
source "$repo/config/pins.env"
PIXI_SOURCE="$repo/.bootstrap/pixi"
test -d "$repo" && test -f "$repo/pixi.lock"
test ! -e "$status"
mkdir -p "$work/project" "$work/cache" "$work/tmp" "$work/xdg" "$work/pixi-home" "$artifact/bin"
printf '%s  %s\n' "$PIXI_SHA256" "$PIXI_SOURCE" | sha256sum -c -
test "$("$PIXI_SOURCE" --version)" = "pixi $PIXI_VERSION"
cp "$PIXI_SOURCE" "$artifact/bin/pixi"
chmod 755 "$artifact/bin/pixi"
cp "$repo/pixi.toml" "$work/project/pixi.toml"
cp "$repo/pixi.lock" "$work/project/pixi.lock"
export PIXI_CACHE_DIR="$work/cache" PIXI_HOME="$work/pixi-home" TMPDIR="$work/tmp" XDG_CACHE_HOME="$work/xdg"
export PYTHONNOUSERSITE=1
unset PYTHONPATH PYTHONHOME PIXI_OFFLINE
"$artifact/bin/pixi" install --locked --manifest-path "$work/project/pixi.toml"
"$repo/scripts/import-check.sh" "$work/project/.pixi/envs/default/bin/python"
rm -rf "$work/project/.pixi"
tar -C "$work" -czf "$artifact/archive.tar.gz" cache project/pixi.toml project/pixi.lock
( cd "$artifact" && sha256sum archive.tar.gz > archive.tar.gz.sha256 && sha256sum bin/pixi > pixi.sha256 )

# Exercise the batch module with the real archive in a second, offline prefix.
# Builds use scratch (copyq need not provide JOBFS); a normal-queue JOBFS smoke
# test remains part of release verification.
install -m 0755 "$repo/runtime/prepare-jobfs.sh" "$repo/runtime/are-prescript.sh" \
  "$repo/runtime/pixi-jobfs-wrapper" "$repo/scripts/import-check.sh" "$artifact/bin/"
mkdir -p "$work/modulefiles/are-pixi"
sed "s|@RELEASE@|$artifact|g" "$repo/runtime/modulefile.tcl.in" > "$work/modulefiles/are-pixi/test"
(
    unset CONFIG_FILE
    export PBS_JOBFS="$work/verify"
    module use "$work/modulefiles"
    module load are-pixi/test
    test "$(command -v python)" = "$PIXI_JOBFS_PROJECT/.pixi/envs/default/bin/python"
    test "$PIXI_OFFLINE" = true
    cmp "$repo/pixi.toml" "$PIXI_JOBFS_PROJECT/pixi.toml"
    cmp "$repo/pixi.lock" "$PIXI_JOBFS_PROJECT/pixi.lock"
    "$repo/scripts/import-check.sh" "$(command -v python)"
    test ! -e "$PBS_JOBFS/are-pixi-py312/kernels"
    module unload are-pixi/test
)
printf 'build_and_offline_test_passed archive_bytes=%s\n' "$(stat -c %s "$artifact/archive.tar.gz")"
[[ $work == "$GADI_RUN_DIR/work" && -d $work && ! -L $work ]]
rm -rf -- "$work"
